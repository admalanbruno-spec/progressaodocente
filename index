import React, { useState, useEffect } from 'react';
import { 
  Calendar, 
  Clock, 
  AlertTriangle, 
  CheckCircle, 
  Mail, 
  FileText, 
  ChevronRight, 
  User, 
  Sliders, 
  Download, 
  Trash2, 
  Plus, 
  Info,
  Sparkles,
  Bell,
  Search,
  Check,
  UserCheck,
  Database,
  PlusCircle,
  Lock,
  Unlock,
  X
} from 'lucide-react';

// Criando um ícone Briefcase em SVG inline para evitar erros de importação
const BriefcaseIcon = ({ size = 24, className = "" }) => (
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    width={size} 
    height={size} 
    viewBox="0 0 24 24" 
    fill="none" 
    stroke="currentColor" 
    strokeWidth="2" 
    strokeLinecap="round" 
    strokeLinejoin="round" 
    className={className}
  >
    <path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
    <rect width="20" height="14" x="2" y="6" rx="2" />
  </svg>
);

// Estrutura de classes e níveis da Carreira EBTT (Ensino Básico, Técnico e Tecnológico)
const CLASSES_NIVEIS = [
  { id: 'A1', classe: 'Classe A', nivel: 'Nível 1', codigoFormatado: 'A-1', cargo: 'Adjunto A' },
  { id: 'A2', classe: 'Classe A', nivel: 'Nível 2', codigoFormatado: 'A-2', cargo: 'Adjunto A' },
  { id: 'B1', classe: 'Classe B', nivel: 'Nível 1', codigoFormatado: 'B-1', cargo: 'Assistente B' },
  { id: 'B2', classe: 'Classe B', nivel: 'Nível 2', codigoFormatado: 'B-2', cargo: 'Assistente B' },
  { id: 'B3', classe: 'Classe B', nivel: 'Nível 3', codigoFormatado: 'B-3', cargo: 'Assistente B' },
  { id: 'B4', classe: 'Classe B', nivel: 'Nível 4', codigoFormatado: 'B-4', cargo: 'Assistente B' },
  { id: 'C1', classe: 'Classe C', nivel: 'Nível 1', codigoFormatado: 'C-1', cargo: 'Adjunto C' },
  { id: 'C2', classe: 'Classe C', nivel: 'Nível 2', codigoFormatado: 'C-2', cargo: 'Adjunto C' },
  { id: 'C3', classe: 'Classe C', nivel: 'Nível 3', codigoFormatado: 'C-3', cargo: 'Adjunto C' },
  { id: 'C4', classe: 'Classe C', nivel: 'Nível 4', codigoFormatado: 'C-4', cargo: 'Adjunto C' },
  { id: 'D1', classe: 'Classe D', nivel: 'Nível 1', codigoFormatado: 'D-1', cargo: 'Associado D' },
  { id: 'D2', classe: 'Classe D', nivel: 'Nível 2', codigoFormatado: 'D-2', cargo: 'Associado D' },
  { id: 'D3', pointerEvents: 'none', classe: 'Classe D', nivel: 'Nível 3', codigoFormatado: 'D-3', cargo: 'Associado D' },
  { id: 'D4', classe: 'Classe D', nivel: 'Nível 4', codigoFormatado: 'D-4', cargo: 'Associado D' },
  { id: 'E1', classe: 'Classe E (Titular)', nivel: 'Nível Único', codigoFormatado: 'E-1', cargo: 'Titular' },
];

// Base de dados inicial de servidores docentes ativos
const BASE_INICIAL_DOCENTES = [
  {
    siape: '1543289',
    nome: 'Carlos Eduardo Souza Silva',
    classeNivelAtual: 'A2',
    dataUltimoEvento: '2023-08-15',
    possuiDoutorado: false,
    descontos: []
  },
  {
    siape: '2345671',
    nome: 'Maria de Fátima dos Santos',
    classeNivelAtual: 'B4',
    dataUltimoEvento: '2024-02-10',
    possuiDoutorado: true,
    descontos: [
      { id: 1, tipo: 'VIII', dias: 8, descricao: 'Faltas não justificadas em período letivo' }
    ]
  },
  {
    siape: '3456782',
    nome: 'Ana Beatris Costa Medeiros',
    classeNivelAtual: 'D4',
    dataUltimoEvento: '2024-05-20',
    possuiDoutorado: true,
    descontos: []
  },
  {
    siape: '1892345',
    nome: 'João Alfredo de Oliveira',
    classeNivelAtual: 'D4',
    dataUltimoEvento: '2024-04-12',
    possuiDoutorado: false,
    descontos: []
  },
  {
    siape: '2567893',
    nome: 'Patrícia Roberta Lima Moura',
    classeNivelAtual: 'C2',
    dataUltimoEvento: '2024-01-15',
    possuiDoutorado: true,
    descontos: [
      { id: 2, tipo: 'VII', dias: 45, descricao: 'Licença sem vencimentos para interesse particular' }
    ]
  }
];

export default function App() {
  // Estado de Autenticação Administrativa
  const [isAdmin, setIsAdmin] = useState(false);
  const [showAdminModal, setShowAdminModal] = useState(false);
  const [senhaDigitada, setSenhaDigitada] = useState('');
  const [erroLogin, setErroLogin] = useState('');

  // Estado da Base de Dados de Docentes (pode ser alimentada dinamicamente)
  const [bancoDocentes, setBancoDocentes] = useState(BASE_INICIAL_DOCENTES);

  // Estado de Busca
  const [busca, setBusca] = useState('');
  const [docenteSelecionado, setDocenteSelecionado] = useState(null);
  const [sugestoes, setSugestoes] = useState([]);

  // Estado do Servidor Ativo (carregado a partir da busca)
  const [nome, setNome] = useState('');
  const [siape, setSiape] = useState('');
  const [classeNivelAtual, setClasseNivelAtual] = useState('A1');
  const [dataUltimoEvento, setDataUltimoEvento] = useState('');
  const [possuiDoutorado, setPossuiDoutorado] = useState(false);
  const [descontos, setDescontos] = useState([]);

  // Estado para Cadastro de Novo Docente no Banco de Dados
  const [cadNome, setCadNome] = useState('');
  const [cadSiape, setCadSiape] = useState('');
  const [cadClasseNivel, setCadClasseNivel] = useState('A1');
  const [cadDataEvento, setCadDataEvento] = useState('');
  const [cadDoutorado, setCadDoutorado] = useState(false);

  // Estado de novos Descontos Simulado
  const [novoDescontoTipo, setNovoDescontoTipo] = useState('VII');
  const [novoDescontoDias, setNovoDescontoDias] = useState('');
  const [novoDescontoDescricao, setNovoDescontoDescricao] = useState('');

  // Estado dos Alertas
  const [receberAlerta, setReceberAlerta] = useState(false);
  const [emailAlerta, setEmailAlerta] = useState('');
  const [alertaConfigurado, setAlertaConfigurado] = useState(false);
  
  // Estados de Exibição de Resultados e UI
  const [abaAtiva, setAbaAtiva] = useState('calculadora');
  const [mostrarToast, setMostrarToast] = useState(false);
  const [toastMensagem, setToastMensagem] = useState('');

  // Tipos de afastamentos regulados pelo Artigo 14
  const TIPOS_DESCONTO = {
    'I': { label: 'Exercício em outros cargos efetivos/comissionados não concomitantes', defaultDias: 30 },
    'II': { label: 'Contratado temporário (Lei 8.745/93)', defaultDias: 60 },
    'III': { label: 'Período em emprego público', defaultDias: 90 },
    'IV': { label: 'Serviço militar prestado às forças armadas (exceções art. 100)', defaultDias: 180 },
    'V': { label: 'Período de disponibilidade', defaultDias: 45 },
    'VI': { label: 'Afastamento por segurança disciplinar ou preventiva', defaultDias: 15 },
    'VII': { label: 'Afastamento por usufruto de licença não remunerada', defaultDias: 365 },
    'VIII': { label: 'Faltas não justificadas', defaultDias: 5 },
  };

  // Gerenciador de busca e sugestões em tempo real buscando do estado dinâmico bancoDocentes
  useEffect(() => {
    if (busca.trim().length > 0) {
      const termo = busca.toLowerCase();
      const filtrados = bancoDocentes.filter(
        docente => 
          docente.nome.toLowerCase().includes(termo) || 
          docente.siape.includes(termo)
      );
      setSugestoes(filtrados);
    } else {
      setSugestoes([]);
    }
  }, [busca, bancoDocentes]);

  const showToast = (msg) => {
    setToastMensagem(msg);
    setMostrarToast(true);
    setTimeout(() => setMostrarToast(false), 4000);
  };

  // Retorna a string formatada do nível, ex: "A-2" ou "D-4"
  const obterNivelFormatado = (classeId) => {
    const correspondente = CLASSES_NIVEIS.find(cn => cn.id === classeId);
    return correspondente ? correspondente.codigoFormatado : classeId;
  };

  // Trata o login de administrador
  const handleAdminLogin = (e) => {
    e.preventDefault();
    if (senhaDigitada === 'admin123') {
      setIsAdmin(true);
      setShowAdminModal(false);
      setSenhaDigitada('');
      setErroLogin('');
      setAbaAtiva('admin_banco');
      showToast('Acesso administrativo concedido!');
    } else {
      setErroLogin('Senha incorreta. Tente novamente ou use a dica.');
    }
  };

  const handleAdminLogout = () => {
    setIsAdmin(false);
    if (abaAtiva === 'admin_banco') {
      setAbaAtiva('calculadora');
    }
    showToast('Sessão de administrador encerrada.');
  };

  // Carrega os dados do docente selecionado para a tela ativa
  const selecionarDocente = (docente) => {
    setDocenteSelecionado(docente);
    setNome(docente.nome);
    setSiape(docente.siape);
    setClasseNivelAtual(docente.classeNivelAtual);
    setDataUltimoEvento(docente.dataUltimoEvento);
    setPossuiDoutorado(docente.possuiDoutorado);
    setDescontos(docente.descontos || []);
    setBusca('');
    setSugestoes([]);
    showToast(`Ficha de ${docente.nome} carregada com sucesso!`);
  };

  // Submete o cadastro de um novo docente adicionando-o ao estado ativo
  const handleCadastrarDocente = (e) => {
    e.preventDefault();
    if (!cadNome.trim() || !cadSiape.trim() || !cadDataEvento) {
      showToast('Por favor, preencha todos os campos obrigatórios do docente.');
      return;
    }
    if (cadSiape.trim().length !== 7 || isNaN(cadSiape)) {
      showToast('O SIAPE deve conter exatamente 7 dígitos numéricos.');
      return;
    }
    // Verifica duplicidade
    if (bancoDocentes.some(d => d.siape === cadSiape.trim())) {
      showToast('Já existe um docente cadastrado com este número de SIAPE.');
      return;
    }

    const novoDocente = {
      nome: cadNome.trim(),
      siape: cadSiape.trim(),
      classeNivelAtual: cadClasseNivel,
      dataUltimoEvento: cadDataEvento,
      possuiDoutorado: cadDoutorado,
      descontos: []
    };

    setBancoDocentes([...bancoDocentes, novoDocente]);
    setCadNome('');
    setCadSiape('');
    setCadClasseNivel('A1');
    setCadDataEvento('');
    setCadDoutorado(false);
    showToast('Docente cadastrado com sucesso na base de dados ativa!');
  };

  // Remove um docente cadastrado da base
  const handleExcluirDocenteDoBanco = (siapeExcluir) => {
    setBancoDocentes(bancoDocentes.filter(d => d.siape !== siapeExcluir));
    if (docenteSelecionado && docenteSelecionado.siape === siapeExcluir) {
      setDocenteSelecionado(null);
    }
    showToast('Docente removido da base de dados com sucesso.');
  };

  // Adicionar desconto de afastamento ao docente selecionado
  const handleAdicionarDesconto = (e) => {
    e.preventDefault();
    if (!novoDescontoDias || isNaN(novoDescontoDias) || parseInt(novoDescontoDias) <= 0) {
      showToast('Por favor, insira um número válido de dias.');
      return;
    }

    const novo = {
      id: Date.now(),
      tipo: novoDescontoTipo,
      dias: parseInt(novoDescontoDias),
      descricao: novoDescontoDescricao || TIPOS_DESCONTO[novoDescontoTipo].label
    };

    const novosDescontos = [...descontos, novo];
    setDescontos(novosDescontos);

    // Atualiza também na lista do banco de dados principal
    setBancoDocentes(bancoDocentes.map(d => {
      if (d.siape === siape) {
        return { ...d, descontos: novosDescontos };
      }
      return d;
    }));

    setNovoDescontoDias('');
    setNovoDescontoDescricao('');
    showToast('Simulação de afastamento adicionada. Data recalculada.');
  };

  const handleRemoverDesconto = (id) => {
    const novosDescontos = descontos.filter(item => item.id !== id);
    setDescontos(novosDescontos);

    // Atualiza também na lista do banco de dados principal
    setBancoDocentes(bancoDocentes.map(d => {
      if (d.siape === siape) {
        return { ...d, descontos: novosDescontos };
      }
      return d;
    }));

    showToast('Afastamento removido do cálculo.');
  };

  // Lógica matemática de cálculo baseada nos dados do docente
  const calcularProgressao = () => {
    if (!dataUltimoEvento) return null;

    const dataBase = new Date(dataUltimoEvento);
    if (isNaN(dataBase.getTime())) return null;

    const indexAtual = CLASSES_NIVEIS.findIndex(c => c.id === classeNivelAtual);
    if (indexAtual === -1) return null;

    const atual = CLASSES_NIVEIS[indexAtual];
    
    // Se já for o último nível da carreira (Titular)
    if (indexAtual === CLASSES_NIVEIS.length - 1) {
      return {
        ultimoNivel: true,
        classeAtual: atual.classe,
        nivelAtual: atual.nivel,
        cargoAtual: atual.cargo,
        codigoFormatado: atual.codigoFormatado
      };
    }

    const proximo = CLASSES_NIVEIS[indexAtual + 1];
    
    // Configuração de meses baseado nos artigos legais fornecidos
    let intersticioMeses = 24; 
    let artigoAplicado = 'Art. 5º (Interstício padrão de 24 meses)';
    let requisitosEspeciais = [];

    if (classeNivelAtual === 'A2') {
      intersticioMeses = 36;
      artigoAplicado = 'Art. 6º (Promoção de Classe A para B)';
      requisitosEspeciais.push('Cumprimento de 36 meses no último nível da Classe A.');
      requisitosEspeciais.push('Aprovação em avaliação individual de desempenho.');
    } else if (classeNivelAtual === 'B4') {
      intersticioMeses = 24;
      artigoAplicado = 'Art. 7º (Promoção de Classe B para C)';
      requisitosEspeciais.push('Cumprimento de 24 meses no nível B4.');
      requisitosEspeciais.push('Aprovação em avaliação individual de desempenho.');
    } else if (classeNivelAtual === 'D4') {
      intersticioMeses = 24;
      artigoAplicado = 'Art. 8º (Promoção para Classe Titular)';
      requisitosEspeciais.push('Possuir o título de Doutor.');
      requisitosEspeciais.push('Cumprimento de interstício mínimo de 24 meses no nível D4.');
      requisitosEspeciais.push('Aprovação em processo de avaliação de desempenho.');
      requisitosEspeciais.push('Aprovação de memorial de atividades ou defesa de tese inédita.');
      if (!possuiDoutorado) {
        requisitosEspeciais.push('⚠️ ALERTA: O servidor não possui o título de doutor registrado. A promoção está suspensa até a titulação.');
      }
    } else {
      requisitosEspeciais.push('Cumprimento de 24 meses em efetivo exercício.');
      requisitosEspeciais.push('Aprovação em avaliação de desempenho individual.');
    }

    // Calcula data futura
    const dataCalculada = new Date(dataBase);
    dataCalculada.setMonth(dataCalculada.getMonth() + intersticioMeses);

    // Aplica descontos de tempo (Art. 14)
    let totalDiasDesconto = 0;
    descontos.forEach(d => {
      totalDiasDesconto += d.dias;
    });

    if (totalDiasDesconto > 0) {
      dataCalculada.setDate(dataCalculada.getDate() + totalDiasDesconto);
    }

    // Alerta de 5 dias
    const dataAlerta = new Date(dataCalculada);
    dataAlerta.setDate(dataAlerta.getDate() - 5);

    // Retorna strings formatadas para o JSX
    return {
      ultimoNivel: false,
      classeAtual: atual.classe,
      nivelAtual: atual.nivel,
      cargoAtual: atual.cargo,
      codigoFormatado: atual.codigoFormatado,
      proximaClasse: proximo.classe,
      proximoNivel: proximo.nivel,
      proximoCargo: proximo.cargo,
      proximoCodigoFormatado: proximo.codigoFormatado,
      intersticioMeses,
      artigoAplicado,
      requisitosEspeciais,
      totalDiasDesconto,
      dataFinalFormatada: dataCalculada.toLocaleDateString('pt-BR', {
        weekday: 'long',
        year: 'numeric',
        month: 'long',
        day: 'numeric'
      }),
      dataFinalCurta: dataCalculada.toLocaleDateString('pt-BR'),
      dataAlertaCurta: dataAlerta.toLocaleDateString('pt-BR'),
      bloqueadoFaltaRequisitos: classeNivelAtual === 'D4' && !possuiDoutorado
    };
  };

  const resultado = calcularProgressao();

  const handleConfigurarAlerta = (e) => {
    e.preventDefault();
    if (!emailAlerta.trim()) {
      showToast('Por favor, digite um e-mail válido.');
      return;
    }
    setAlertaConfigurado(true);
    showToast(`Configurado! Um lembrete será enviado para ${emailAlerta} com o formulário anexo.`);
  };

  return (
    <div className="min-h-screen bg-slate-50 text-slate-800 font-sans flex flex-col">
      
      {/* Toast de Notificação */}
      {mostrarToast && (
        <div className="fixed top-5 right-5 z-50 bg-slate-900 text-white px-5 py-3 rounded-lg shadow-2xl flex items-center gap-3 border border-slate-700 max-w-sm">
          <Sparkles className="text-emerald-400 shrink-0" size={18} />
          <p className="text-sm font-medium">{toastMensagem}</p>
        </div>
      )}

      {/* MODAL DE LOGIN DO ADMINISTRADOR */}
      {showAdminModal && (
        <div className="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
          <div className="bg-white rounded-2xl max-w-sm w-full p-6 shadow-2xl border border-slate-200 relative animate-fadeIn">
            <button 
              onClick={() => {
                setShowAdminModal(false);
                setErroLogin('');
                setSenhaDigitada('');
              }}
              className="absolute top-4 right-4 text-slate-400 hover:text-slate-600 transition-colors"
            >
              <X size={18} />
            </button>

            <div className="flex flex-col items-center text-center space-y-3 mb-5">
              <div className="p-3 bg-emerald-50 text-emerald-700 rounded-full">
                <Lock size={24} />
              </div>
              <h3 className="font-extrabold text-slate-800 text-lg">Acesso Restrito ao Administrador</h3>
              <p className="text-xs text-slate-500 leading-relaxed">
                Digite a chave administrativa para desbloquear a aba de cadastro e modificação de servidores.
              </p>
            </div>

            <form onSubmit={handleAdminLogin} className="space-y-4">
              <div>
                <label className="block text-[10px] uppercase font-bold text-slate-500 mb-1.5">Senha de Acesso</label>
                <input
                  type="password"
                  required
                  placeholder="••••••••"
                  value={senhaDigitada}
                  onChange={(e) => setSenhaDigitada(e.target.value)}
                  className="w-full px-3.5 py-2.5 rounded-lg border border-slate-250 focus:ring-2 focus:ring-emerald-500 text-sm focus:outline-hidden text-center bg-slate-50"
                />
                {erroLogin && (
                  <p className="text-[11px] text-rose-600 mt-1.5 text-center font-medium">{erroLogin}</p>
                )}
              </div>

              <div className="bg-slate-50 p-2 rounded-lg text-center border border-slate-150">
                <span className="text-[10px] text-slate-400 block font-semibold">Chave de Demonstração</span>
                <span className="font-mono text-xs text-emerald-700 font-bold">admin123</span>
              </div>

              <button
                type="submit"
                className="w-full py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white font-bold rounded-lg transition-colors text-xs flex items-center justify-center gap-1.5"
              >
                <Unlock size={14} /> Desbloquear Painel
              </button>
            </form>
          </div>
        </div>
      )}

      {/* Cabeçalho Neutro */}
      <header className="bg-gradient-to-r from-emerald-800 to-green-700 text-white shadow-md">
        <div className="max-w-7xl mx-auto px-4 py-6 sm:px-6 lg:px-8 flex flex-col sm:flex-row justify-between items-center gap-4">
          <div>
            <h1 className="text-2xl font-black tracking-tight flex items-center gap-2">
              <BriefcaseIcon size={24} className="text-emerald-300" />
              SISPRA-EBTT
            </h1>
            <p className="text-xs text-emerald-100 font-medium">Sistema de Gestão e Consulta de Progressão Funcional Docente</p>
          </div>
          
          <div className="flex items-center gap-3">
            {/* BOTÃO CONDICIONAL DE ADMINISTRAÇÃO */}
            {!isAdmin ? (
              <button 
                onClick={() => setShowAdminModal(true)}
                className="flex items-center gap-1.5 bg-slate-800/80 hover:bg-slate-900 text-white text-xs px-3.5 py-2 rounded-lg transition-colors border border-slate-700/50 shadow-sm"
              >
                <Lock size={12} className="text-emerald-400" />
                <span>Área do Admin</span>
              </button>
            ) : (
              <div className="flex items-center gap-2">
                <span className="text-[11px] bg-emerald-900/60 border border-emerald-500/30 px-2.5 py-1 rounded-md text-emerald-300 font-bold flex items-center gap-1">
                  <span className="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  Modo Admin Ativo
                </span>
                <button 
                  onClick={handleAdminLogout}
                  className="flex items-center gap-1.5 bg-rose-700/90 hover:bg-rose-800 text-white text-xs px-3 py-1.5 rounded-md transition-colors"
                >
                  <Unlock size={12} />
                  <span>Sair</span>
                </button>
              </div>
            )}
            
            <div className="hidden sm:flex items-center gap-2 bg-emerald-900/40 px-3 py-1.5 rounded-md border border-emerald-600/30 text-xs">
              <span className="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>Consulta Ficha Funcional Integrada & Base Cadastrada</span>
            </div>
          </div>
        </div>
      </header>

      {/* Menu de Abas */}
      <nav className="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-xs">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex space-x-1 py-2 overflow-x-auto">
            <button
              onClick={() => setAbaAtiva('calculadora')}
              className={`flex items-center gap-2 px-4 py-2.5 rounded-md text-sm font-semibold transition-all shrink-0 ${
                abaAtiva === 'calculadora'
                  ? 'bg-emerald-50 text-emerald-700 border-b-2 border-emerald-600'
                  : 'text-slate-600 hover:bg-slate-100'
