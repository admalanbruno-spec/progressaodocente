                <form onSubmit={handleCadastrarDocente} className="space-y-4 text-xs">
                  {/* Nome Completo */}
                  <div>
                    <label className="block font-bold text-slate-600 mb-1">Nome Completo do Docente *</label>
                    <input
                      type="text"
                      required
                      value={cadNome}
                      onChange={(e) => setCadNome(e.target.value)}
                      placeholder="Ex: Carlos Eduardo Souza Silva"
                      className="w-full px-3.5 py-2 rounded-lg border border-slate-200 focus:ring-1 focus:ring-emerald-500 bg-slate-50 focus:bg-white text-xs focus:outline-hidden"
                    />
                  </div>

                  {/* Matrícula SIAPE */}
                  <div>
                    <label className="block font-bold text-slate-600 mb-1">Matrícula SIAPE (7 dígitos) *</label>
                    <input
                      type="text"
                      required
                      maxLength={7}
                      value={cadSiape}
                      onChange={(e) => setCadSiape(e.target.value.replace(/\D/g, ''))}
                      placeholder="Ex: 1543289"
                      className="w-full px-3.5 py-2 rounded-lg border border-slate-200 focus:ring-1 focus:ring-emerald-500 bg-slate-50 focus:bg-white text-xs focus:outline-hidden"
                    />
                  </div>

                  {/* Classe e Nível */}
                  <div>
                    <label className="block font-bold text-slate-600 mb-1">Classe e Nível Atual *</label>
                    <select
                      value={cadClasseNivel}
                      onChange={(e) => setCadClasseNivel(e.target.value)}
                      className="w-full px-3 py-2 rounded-lg border border-slate-200 focus:ring-1 focus:ring-emerald-500 bg-slate-50 focus:bg-white text-xs focus:outline-hidden"
                    >
                      {CLASSES_NIVEIS.map(cn => (
                        <option key={cn.id} value={cn.id}>
                          {cn.classe} — {cn.nivel} ({cn.codigoFormatado})
                        </option>
                      ))}
                    </select>
                  </div>

                  {/* Data do Último Evento */}
                  <div>
                    <label className="block font-bold text-slate-600 mb-1">Início do Ciclo (Última portaria de progressão) *</label>
                    <input
                      type="date"
                      required
                      value={cadDataEvento}
                      onChange={(e) => setCadDataEvento(e.target.value)}
                      className="w-full px-3 py-2 rounded-lg border border-slate-200 focus:ring-1 focus:ring-emerald-500 bg-slate-50 text-xs focus:outline-hidden"
                    />
                  </div>

                  {/* Possui Doutorado */}
                  <div className="bg-slate-50 p-2.5 rounded-lg border border-slate-200">
                    <label className="flex items-center gap-2 cursor-pointer">
                      <input
                        type="checkbox"
                        checked={cadDoutorado}
                        onChange={(e) => setCadDoutorado(e.target.checked)}
                        className="w-4 h-4 text-emerald-600 focus:ring-emerald-500 border-slate-300 rounded"
                      />
                      <span className="font-bold text-slate-700">Este servidor possui Doutorado (Exigência p/ Titular)</span>
                    </label>
                  </div>

                  <button
                    type="submit"
                    className="w-full py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white font-bold rounded-lg transition-colors text-xs flex items-center justify-center gap-1.5"
                  >
                    <Plus size={14} /> Cadastrar Servidor
                  </button>
                </form>
              </div>

              {/* Tabela de Visualização e Exclusão (Col 7) */}
              <div className="lg:col-span-7 bg-white p-6 rounded-2xl border border-slate-200 shadow-xs">
                <div className="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
                  <span className="font-bold text-sm text-slate-700">Servidores Registrados Ativamente</span>
                  <span className="bg-slate-100 text-slate-600 text-xs font-bold px-2 py-0.5 rounded-md">
                    {bancoDocentes.length} servidores
                  </span>
                </div>

                {bancoDocentes.length > 0 ? (
                  <div className="overflow-x-auto text-xs">
                    <table className="w-full text-left border-collapse">
                      <thead>
                        <tr className="bg-slate-50 border-b border-slate-100 text-slate-500 font-bold">
                          <th className="p-2.5">Nome / SIAPE</th>
                          <th className="p-2.5">Classe/Nível</th>
                          <th className="p-2.5">Data Início</th>
                          <th className="p-2.5 text-center">Doutorado</th>
                          <th className="p-2.5 text-right">Ação</th>
                        </tr>
                      </thead>
                      <tbody>
                        {bancoDocentes.map((docente) => (
                          <tr key={docente.siape} className="border-b border-slate-100 hover:bg-slate-50/60 transition-colors">
                            <td className="p-2.5 font-medium">
                              <span className="font-bold text-slate-800 block leading-tight">{docente.nome}</span>
                              <span className="font-mono text-slate-400 text-[10px]">SIAPE: {docente.siape}</span>
                            </td>
                            <td className="p-2.5 text-slate-600">
                              Nível <strong className="font-black text-emerald-800">{obterNivelFormatado(docente.classeNivelAtual)}</strong>
                            </td>
                            <td className="p-2.5 text-slate-600">
                              {new Date(docente.dataUltimoEvento).toLocaleDateString('pt-BR')}
                            </td>
                            <td className="p-2.5 text-center">
                              {docente.possuiDoutorado ? (
                                <span className="bg-emerald-100 text-emerald-800 text-[9px] px-1.5 py-0.2 rounded font-bold">Sim</span>
                              ) : (
                                <span className="bg-slate-100 text-slate-500 text-[9px] px-1.5 py-0.2 rounded font-bold">Não</span>
                              )}
                            </td>
                            <td className="p-2.5 text-right">
                              <button
                                onClick={() => handleExcluirDocenteDoBanco(docente.siape)}
                                className="p-1.5 text-rose-500 hover:bg-rose-50 rounded-lg transition-colors inline-flex"
                                title="Excluir docente da base de dados"
                              >
                                <Trash2 size={13} />
                              </button>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                ) : (
                  <div className="text-center py-12 border-2 border-dashed border-slate-100 rounded-xl">
                    <Database size={36} className="mx-auto text-slate-300 mb-2" />
                    <span className="text-xs text-slate-400 block font-medium">Nenhum docente cadastrado na base de dados.</span>
                    <span className="text-[10px] text-slate-400">Adicione novos no painel ao lado para testar.</span>
                  </div>
                )}
              </div>

            </div>
          </div>
        )}

        {/* ABA: LEGISLAÇÃO */}
        {abaAtiva === 'regulamento' && (
          <div className="bg-white rounded-2xl shadow-xs border border-slate-200 p-6 max-w-4xl mx-auto">
            <div className="flex items-center gap-3 mb-6 pb-4 border-b border-slate-200">
              <div className="p-2 bg-emerald-50 text-emerald-700 rounded-lg">
                <FileText size={24} />
              </div>
              <div>
                <h2 className="font-extrabold text-xl text-slate-800">Diretrizes Legais de Progressão</h2>
                <p className="text-sm text-slate-500">Regras oficiais de promoção de carreira</p>
              </div>
            </div>

            <div className="space-y-6 text-slate-700 text-sm leading-relaxed">
              
              <div className="bg-emerald-50/50 p-4 rounded-xl border border-emerald-100">
                <h3 className="font-bold text-emerald-900 text-sm mb-2 flex items-center gap-1.5">
                  <Info size={16} />
                  Funcionamento dos Ciclos
                </h3>
                <p className="text-xs text-emerald-800">
                  A progressão funcional é regida pelos interstícios de 24 meses padrão, com exceção de transições específicas de classe, acrescidos de eventuais dias de suspensão legal previstos no artigo 14.
                </p>
              </div>

              {/* Seção Artigo 5 */}
              <div className="p-4 rounded-xl border border-slate-100 bg-slate-50/50">
                <span className="text-xs font-extrabold text-emerald-700 uppercase tracking-widest block mb-1">Artigo 5º - Padrão Geral</span>
                <h4 className="font-bold text-slate-800 mb-2">Requisitos para qualquer progressão:</h4>
                <ul className="list-disc pl-5 space-y-1 text-slate-600 text-xs">
                  <li><strong>Interstício:</strong> 24 meses em cada nível.</li>
                  <li><strong>Avaliação:</strong> Aprovação em avaliação individual de desempenho.</li>
                </ul>
              </div>

              {/* Seção Artigo 6 */}
              <div className="p-4 rounded-xl border border-slate-100 bg-slate-50/50">
                <span className="text-xs font-extrabold text-emerald-700 uppercase tracking-widest block mb-1">Artigo 6º - Promoção A para B</span>
                <h4 className="font-bold text-slate-800 mb-2">Requisitos para transição especial:</h4>
                <ul className="list-disc pl-5 space-y-1 text-slate-600 text-xs">
                  <li><strong>Interstício:</strong> 36 meses no nível <strong className="font-bold">A-2</strong>.</li>
                  <li><strong>Avaliação:</strong> Aprovação em avaliação individual de desempenho.</li>
                </ul>
              </div>

              {/* Seção Artigo 7 */}
              <div className="p-4 rounded-xl border border-slate-100 bg-slate-50/50">
                <span className="text-xs font-extrabold text-emerald-700 uppercase tracking-widest block mb-1">Artigo 7º - Promoção B para C</span>
                <h4 className="font-bold text-slate-800 mb-2">Requisitos para transição:</h4>
                <ul className="list-disc pl-5 space-y-1 text-slate-600 text-xs">
                  <li><strong>Interstício:</strong> 24 meses no nível <strong className="font-bold">B-4</strong>.</li>
                  <li><strong>Avaliação:</strong> Aprovação em avaliação individual de desempenho.</li>
                </ul>
              </div>

              {/* Seção Artigo 8 */}
              <div className="p-4 rounded-xl border border-slate-100 bg-slate-50/50">
                <span className="text-xs font-extrabold text-emerald-700 uppercase tracking-widest block mb-1">Artigo 8º - Professor Titular (Classe E)</span>
                <h4 className="font-bold text-slate-800 mb-2">Requisitos especiais para Titular:</h4>
                <ul className="list-disc pl-5 space-y-1 text-slate-600 text-xs">
                  <li><strong>Título:</strong> Doutoramento obrigatório.</li>
                  <li><strong>Interstício:</strong> 24 meses no nível <strong className="font-bold">D-4</strong>.</li>
                  <li><strong>Aprovações:</strong> Avaliação funcional + Memorial ou defesa de tese inédita.</li>
                </ul>
              </div>
            </div>
          </div>
        )}

        {/* ABA: SIMULADOR DE E-MAIL */}
        {abaAtiva === 'simulador_email' && (
          <div className="max-w-4xl mx-auto space-y-6">
            
            <div className="bg-white rounded-2xl shadow-xs border border-slate-200 p-6">
              <div className="flex items-center gap-3 mb-4 pb-3 border-b border-slate-100">
                <div className="p-2 bg-emerald-50 text-emerald-700 rounded-lg">
                  <Mail size={24} />
                </div>
                <div>
                  <h2 className="font-extrabold text-xl text-slate-800">Serviço de Alertas por E-mail</h2>
                  <p className="text-sm text-slate-500">Agendamento de lembrete com documentos em anexo</p>
                </div>
              </div>

              <div className="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
                <div className="md:col-span-7 space-y-3">
                  <p className="text-sm text-slate-600 leading-relaxed">
                    Evite atrasos financeiros por prazos expirados. Cadastrando seu e-mail institucional, o sistema envia instruções no momento correto de requisição da sua progressão.
                  </p>
                  <p className="text-xs text-slate-500">
                    Sua notificação é disparada <strong>5 dias antes</strong> do fim do interstício, guiando o protocolo no sistema interno.
                  </p>
                </div>

                <div className="md:col-span-5 bg-slate-50 p-4 rounded-xl border border-slate-200">
                  <form onSubmit={handleConfigurarAlerta} className="space-y-3">
                    <span className="text-xs font-extrabold text-slate-700 block uppercase">Configurar Alerta</span>
                    
                    <div>
                      <label className="block text-[10px] uppercase font-bold text-slate-500 mb-1">E-mail para Recebimento</label>
                      <input
                        type="email"
                        required
                        placeholder="nome.servidor@instituto.edu.br"
                        value={emailAlerta}
                        onChange={(e) => {
                          setEmailAlerta(e.target.value);
                          setReceberAlerta(true);
                        }}
                        className="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs focus:ring-2 focus:ring-emerald-500 focus:outline-hidden"
                      />
                    </div>

                    <button
                      type="submit"
                      className="w-full py-2 bg-emerald-700 text-white text-xs font-bold rounded-lg hover:bg-emerald-800 transition-colors flex items-center justify-center gap-1.5"
                    >
                      <Bell size={14} />
                      {alertaConfigurado ? 'Alerta Ativo ✓' : 'Ativar Lembrete'}
                    </button>
                  </form>
                </div>
              </div>
            </div>

            {receberAlerta && docenteSelecionado && (
              <div className="bg-white rounded-2xl shadow-xs border border-slate-200 overflow-hidden">
                <div className="bg-slate-100 px-4 py-2 text-slate-500 text-xs font-mono flex items-center justify-between border-b border-slate-200">
                  <span>Visualização de E-mail Automático</span>
                  <span className="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded font-bold text-[9px]">
                    DISPARO EM {resultado ? resultado.dataAlertaCurta : ''}
                  </span>
                </div>

                <div className="p-6 space-y-4">
                  <div className="border-b border-slate-100 pb-3 text-xs space-y-1">
                    <div><span className="font-bold text-slate-600">De:</span> assessoria.carreira@instituto.edu.br</div>
                    <div><span className="font-bold text-slate-600">Para:</span> {emailAlerta || 'servidor@instituto.edu.br'}</div>
                    <div><span className="font-bold text-slate-600">Assunto:</span> ⚠️ Alerta de Progressão Funcional Docente — {nome}</div>
                  </div>

                  <div className="space-y-3 text-xs leading-relaxed text-slate-700">
                    <p className="font-bold text-slate-800">Prezado(a) docente {nome},</p>
                    
                    <p>
                      Informamos que em <strong>5 dias</strong> (vencimento em <strong>{resultado ? resultado.dataFinalCurta : ''}</strong>) seu interstício funcional para progressão na carreira EBTT será completado.
                    </p>

                    <div className="bg-slate-50 p-3 rounded-lg border border-slate-200 grid grid-cols-2 gap-3">
                      <div>
                        <span className="text-[10px] text-slate-400 font-bold block">CLASSE / NÍVEL ATUAL</span>
                        <span className="text-slate-700 font-normal">
                          {resultado ? resultado.classeAtual : ''} (<strong className="font-black text-emerald-800">{resultado ? resultado.codigoFormatado : ''}</strong>)
                        </span>
                      </div>
                      <div>
                        <span className="text-[10px] text-slate-400 font-bold block">PRÓXIMO ALVO</span>
                        <span className="text-slate-700 font-normal">
                          {resultado ? resultado.proximaClasse : ''} (<strong className="font-black text-emerald-800">{resultado ? resultado.proximoCodigoFormatado : ''}</strong>)
                        </span>
                      </div>
                    </div>

                    <p>
                      Para que o processo de progressão ocorra sem atrasos, solicitamos que realize o preenchimento do **Formulário de Avaliação Individual de Desempenho** em anexo e inicie o protocolo.
                    </p>

                    {/* Documentos Anexos */}
                    <div className="mt-4 p-4 border border-slate-200 rounded-lg bg-emerald-50/20">
                      <span className="text-xs font-bold text-emerald-800 block mb-2">Anexos prontos para Download:</span>
                      <div className="flex flex-col sm:flex-row gap-2">
                        <div className="flex-1 bg-white p-3 rounded border border-slate-200 flex items-center justify-between">
                          <div className="flex items-center gap-2">
                            <FileText className="text-emerald-700" size={24} />
                            <div>
                              <span className="font-bold text-slate-700 text-xs block">Formulário_Avaliação_Desempenho.docx</span>
                              <span className="text-[10px] text-slate-400">Word editável com checklist</span>
                            </div>
                          </div>
                          <button 
                            type="button" 
                            onClick={() => showToast('Formulário de Avaliação Baixado.')}
                            className="p-2 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 rounded-md transition-colors"
                          >
                            <Download size={14} />
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            )}

          </div>
        )}

      </main>

      {/* Rodapé institucional padrão */}
      <footer className="bg-slate-900 text-slate-400 text-xs py-8 mt-12 border-t border-slate-800">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-3">
          <p className="font-bold text-slate-300">SISPRA-EBTT — SISTEMA INTEGRADO DE PROGRESSÃO FUNCIONAL</p>
          <div className="max-w-md mx-auto text-[11px] text-slate-500 leading-relaxed">
            Desenvolvido em conformidade com as regras vigentes da Carreira Docente EBTT. Os dados apresentados correspondem à ficha de cadastro integrada no banco de dados corporativo do servidor.
          </div>
        </div>
      </footer>

    </div>
  );
}
